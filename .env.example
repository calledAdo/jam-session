# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
AUTH_DISABLED=true

# --- AI provider (pick one) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OpenAI-compatible endpoint:
# OPENAI_BASE_URL=https://example.com/v1
# AGENT_ENGINE=ai-sdk:openai
# AGENT_MODEL=
